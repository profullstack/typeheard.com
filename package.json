{
  "name": "typeheard.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drop a recording, get what was said. Transcription on whisper.cpp, billed by the minute, with a CLI, TUI, MCP server and API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --hot apps/web/src/main.js",
    "start": "bun apps/web/src/main.js",
    "migrate": "bun packages/db/src/migrate-cli.js",
    "test": "bun test",
    "lint": "bun run --bun biome check .",
    "format": "bun run --bun biome format --write ."
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@profullstack/throttle": "^0.2.3"
  }
}
